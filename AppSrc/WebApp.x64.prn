36752>>>Open entrenador
36754>>>
36754>>>Object oEntrenadorSelect is a cWebView
36756>>>    Set psCaption to "Lista de Entrenadores"
36757>>>    Set peViewType to vtSelect
36758>>>    
36758>>>    // 1. IMPORTANTE: Esto le dice al servidor que ejecute el evento OnShow
36758>>>    Set pbServerOnShow to True 
36759>>>
36759>>>    Property Boolean pbAllowNoLogin True
36762>>>
36762>>>    Object oentrenador_DD is a centrenadorDataDictionary
36764>>>    End_Object 
36765>>>
36765>>>    Set Main_DD to oentrenador_DD
36766>>>    Set Server  to oentrenador_DD
36767>>>
36767>>>    Object oWebMainPanel is a cWebPanel
36769>>>        Object oEntrenadorList is a cWebList
36771>>>            Set pbFillHeight to True
36772>>>            Set Server to oentrenador_DD
36773>>>            Set piOrdering to 1 
36774>>>
36774>>>            Object oentrenador_Nombre is a cWebColumn
36776>>>                Entry_Item entrenador.Nombre
36777>>>                Set psCaption to "Nombre del Entrenador"
36778>>>                Set piWidth to 300
36779>>>            End_Object 
36780>>>        End_Object
36781>>>    End_Object 
36782>>>
36782>>>    // Cambiamos a este evento que es más "agresivo" al cargar la página
36782>>>    Procedure OnShow
36785>>>        Integer iContador
36785>>>        Forward Send OnShow
36787>>>        
36787>>>        Move 0 to iContador
36788>>>        Send Clear of oentrenador_DD
36789>>>        Send Find of oentrenador_DD FIRST_RECORD 1
36790>>>        While (Found)
36794>>>            Increment iContador
36795>>>            Send Find of oentrenador_DD NEXT_RECORD 1
36796>>>        Loop
36797>>>>
36797>>>        
36797>>>        // Si no sale el InfoBox, usaremos un Error de usuario para forzar la ventana
36797>>>        If (iContador = 0) Begin
36799>>>            Send UserError "El motor no encuentra datos. Revisa permisos de la carpeta Data." "DEBUG"
36800>>>        End
36800>>>>
36800>>>        Else Begin
36801>>>            Send ShowInfoBox ("¡Éxito! Se han encontrado " + String(iContador) + " registros.")
36802>>>        End
36802>>>>
36802>>>        
36802>>>        Send GridRefresh of oEntrenadorList
36803>>>    End_Procedure
36804>>>
36804>>>End_Object
