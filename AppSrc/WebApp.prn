36481>>>>>>>        
36481>>>>>>>        //  Extract parts
36481>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36482>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36483>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36484>>>>>>>        
36484>>>>>>>        //  Fill out with 0
36484>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36487>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36490>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36493>>>>>>>        
36493>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36494>>>>>>>    End_Function
