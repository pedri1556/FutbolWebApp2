36671>>>>>>>        Boolean bRequiresTimeCost
36671>>>>>>>        UInteger uiAlgo uiTimeCost
36671>>>>>>>        Integer iBegin iEnd
36671>>>>>>>        String sSalt
36671>>>>>>>        
36671>>>>>>>        Move 1 to iBegin
36672>>>>>>>        
36672>>>>>>>        // Parse Algo
36672>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36673>>>>>>>        If (not(iEnd)) Function_Return False
36676>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36677>>>>>>>        
36677>>>>>>>        // Parse Salt
36677>>>>>>>        Move (iEnd + 1) to iBegin
36678>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36679>>>>>>>        If (not(iEnd)) Function_Return False
36682>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36683>>>>>>>        
36683>>>>>>>        Case Begin
36683>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36685>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36688>>>>>>>                Move True to bRequiresTimeCost
36689>>>>>>>                Case Break
36690>>>>>>>            Case Else
36690>>>>>>>                Error 8710 "Invalid algorithm selected."
36691>>>>>>>>
36691>>>>>>>                Function_Return False
36692>>>>>>>        Case End
36692>>>>>>>        
36692>>>>>>>        // Parse optional timecost
36692>>>>>>>        If (bRequiresTimeCost) Begin
36694>>>>>>>            Move (iEnd + 1) to iBegin
36695>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36696>>>>>>>            If (not(iEnd)) Function_Return False
36699>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36700>>>>>>>        End
36700>>>>>>>>
36700>>>>>>>        
36700>>>>>>>        // Parse rest hash
36700>>>>>>>        Move (iEnd + 1) to iBegin
36701>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36702>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36705>>>>>>>        
36705>>>>>>>        // Base64Decode
36705>>>>>>>        UChar[] ucaSalt
36706>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36707>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36710>>>>>>>        
36710>>>>>>>        // Create new hash
36710>>>>>>>        String sNewHash
36710>>>>>>>        If (bRequiresTimeCost) Begin
36712>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36714>>>>>>>                Function_Return False 
36715>>>>>>>            End
36715>>>>>>>>
36715>>>>>>>        End
36715>>>>>>>>
36715>>>>>>>        Else Begin
36716>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36718>>>>>>>                Function_Return False 
36719>>>>>>>            End
36719>>>>>>>>
36719>>>>>>>        End
36719>>>>>>>>
36719>>>>>>>        Function_Return (sNewHash = sHash)
36720>>>>>>>    End_Function
36721>>>>>>>    
36721>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36723>>>>>>>        Boolean bRequireTimeCost
36723>>>>>>>        UBigInt ullSize
36723>>>>>>>        UChar[] ucaSalt
36724>>>>>>>        String sSalt
36724>>>>>>>        
36724>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36725>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36726>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36729>>>>>>>        
36729>>>>>>>        Case Begin
36729>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36731>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36732>>>>>>>                Move True to bRequireTimeCost
36733>>>>>>>                Case Break
36734>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36737>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36738>>>>>>>                Move True to bRequireTimeCost
36739>>>>>>>                Case Break
36740>>>>>>>            Case Else
36740>>>>>>>                Error 8710 "Invalid algorithm selected."
36741>>>>>>>>
36741>>>>>>>                Function_Return 0
36742>>>>>>>        Case End
36742>>>>>>>        
36742>>>>>>>        // calculate base64 in a non-floating-manner
36742>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36743>>>>>>>        
36743>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36744>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36745>>>>>>>        If (bRequireTimeCost) Begin
36747>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36748>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36749>>>>>>>        End
36749>>>>>>>>
36749>>>>>>>        Else Begin
36750>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36751>>>>>>>        End
36751>>>>>>>>
36751>>>>>>>        
36751>>>>>>>        Function_Return ullSize
36752>>>>>>>    End_Function
36753>>>>>>>End_Class
36754>>>>>>>
36754>>>>>>>Class cPasswordHasher is a cObject
36755>>>>>>>    
36755>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36756>>>>>>>    
36756>>>>>>>    Procedure Construct_Object
36758>>>>>>>        Forward Send Construct_Object
36760>>>>>>>        
36760>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36761>>>>>>>        Property UInteger   puiSaltSize         16
36762>>>>>>>        
36762>>>>>>>        Property UInteger   puiOptTimeCost      420000
36763>>>>>>>    End_Procedure
36764>>>>>>>    
36764>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36766>>>>>>>        Boolean bOk
36766>>>>>>>        UInteger uiAlgo
36766>>>>>>>        Get peAlgorithm to uiAlgo
36767>>>>>>>        
36767>>>>>>>        Case Begin
36767>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36769>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36772>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36773>>>>>>>                Case Break
36774>>>>>>>            Case Else
36774>>>>>>>                Error 8710 "Invalid algorithm selected."
36775>>>>>>>>
36775>>>>>>>                Function_Return False
36776>>>>>>>        Case End
36776>>>>>>>        
36776>>>>>>>        Function_Return bOk
36777>>>>>>>    End_Function
36778>>>>>>>    
36778>>>>>>>    Function RequiredBufferSize Returns UBigInt
36780>>>>>>>        UBigInt ullSize
36780>>>>>>>        UInteger uiAlgo
36780>>>>>>>        Get peAlgorithm to uiAlgo
36781>>>>>>>        
36781>>>>>>>        Case Begin
36781>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36783>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36786>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36787>>>>>>>                Case Break
36788>>>>>>>            Case Else
36788>>>>>>>                Error 8710 "Invalid algorithm selected."
36789>>>>>>>>
36789>>>>>>>                Function_Return 0
36790>>>>>>>        Case End
36790>>>>>>>        
36790>>>>>>>        Function_Return ullSize
36791>>>>>>>    End_Function
36792>>>>>>>
36792>>>>>>>End_Class
