36793>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36794>>>>>    
36794>>>>>    Procedure Construct_Object
36796>>>>>        Handle hoObj
36796>>>>>        
36796>>>>>        Forward Send Construct_Object
36798>>>>>        
36798>>>>>        Set pbSessionCookieHttpOnly to True
36799>>>>>        
36799>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36800>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36801>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36802>>>>>        
36802>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36803>>>>>        Set phoUserDD to hoObj
36804>>>>>        
36804>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36805>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36806>>>>>        Set phoSessionDD to hoObj
36807>>>>>        
36807>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36808>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36809>>>>>        Set phoCrypto to hoObj
36810>>>>>        
36810>>>>>        Property Boolean pbPasswordHashing True
36811>>>>>        
36811>>>>>        Property Boolean pbCreatingNewSession False
36812>>>>>        Property String psLoginName
36813>>>>>        Property String psUserName ""
36814>>>>>        Property Integer piUserRights 0
36815>>>>>    End_Procedure
36816>>>>>    
36816>>>>>    Procedure End_Construct_Object
36818>>>>>        Forward Send End_Construct_Object
36820>>>>>        
36820>>>>>        Handle hoCrypto
36820>>>>>        Integer iFieldLen
36820>>>>>        If (pbPasswordHashing(Self)) Begin
36822>>>>>            Get phoCrypto to hoCrypto
36823>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36826>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36828>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36829>>>>>>
36829>>>>>            End
36829>>>>>>
36829>>>>>        End
36829>>>>>>
36829>>>>>    End_Procedure
36830>>>>>    
36830>>>>>    Function CreateSession String sRemoteAddress Returns String
36832>>>>>        String sSessionKey
36832>>>>>        Integer iErr
36832>>>>>        Boolean bLogWebSession
36832>>>>>        Handle hoSessionDD       
36832>>>>>        Get phoSessionDD to hoSessionDD
36833>>>>>        
36833>>>>>        //  Get session key
36833>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36835>>>>>        
36835>>>>>        Get pbLogWebSession to bLogWebSession
36836>>>>>        If not bLogWebSession Begin
36838>>>>>            Function_Return sSessionKey        
36839>>>>>        End
36839>>>>>>
36839>>>>>
36839>>>>>        //  Store session
36839>>>>>        Send Clear of hoSessionDD
36840>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36841>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36842>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36843>>>>>        Get Request_Validate of hoSessionDD to iErr
36844>>>>>        If (iErr) Begin
36846>>>>>            // this should not happen. If it does its a programming error
36846>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36847>>>>>>
36847>>>>>            Function_Return ""
36848>>>>>        End
36848>>>>>>
36848>>>>>        Send Request_Save of hoSessionDD
36849>>>>>        If (Err) Begin
36851>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36851>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36852>>>>>>
36852>>>>>            Function_Return ""
36853>>>>>        End
36853>>>>>>
36853>>>>>       
36853>>>>>        Function_Return sSessionKey        
36854>>>>>    End_Function
36855>>>>>    
36855>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36857>>>>>        DateTime dtLastAccess dtCurrent
36857>>>>>        TimeSpan tsDiff
36857>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36857>>>>>        Boolean bResult bCreatingNewSession
36857>>>>>        Boolean bLogWebSession bLoadWebApp
36857>>>>>        Integer eLoginMode
36857>>>>>        String sTime
36857>>>>>        Handle hoSessionDD hoUserDD       
36857>>>>>        
36857>>>>>        Move False to bLoadWebApp
36858>>>>>        If (num_arguments >= 2) Begin
36860>>>>>            Move bOptLoadWebApp to bLoadWebApp
36861>>>>>        End
36861>>>>>>
36861>>>>>        
36861>>>>>        Get phoSessionDD to hoSessionDD
36862>>>>>        Get phoUserDD to hoUserDD
36863>>>>>        
36863>>>>>        Get pbLogWebSession to bLogWebSession
36864>>>>>        Get peLoginMode to eLoginMode
36865>>>>>        
36865>>>>>        // for this object, you can only disable logging if login completely is disabled
36865>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36867>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36868>>>>>>
36868>>>>>            Function_Return False
36869>>>>>        End
36869>>>>>>
36869>>>>>
36869>>>>>        //  Clear session properties
36869>>>>>        Set psSessionKey to ""
36870>>>>>        Send UpdateSessionProperties True
36871>>>>>        
36871>>>>>        If not bLogWebSession Begin
36873>>>>>            Forward Get ValidateSession sSessionKey to bResult
36875>>>>>            Function_Return bResult
36876>>>>>        End        
36876>>>>>>
36876>>>>>        
36876>>>>>        Move False to bResult
36877>>>>>        Get piSessionTimeout to iSessionTimeout 
36878>>>>>        
36878>>>>>        //  Check if session exists
36878>>>>>        Send Clear of hoSessionDD
36879>>>>>        Move sSessionKey to WebAppSession.SessionKey
36880>>>>>        Send Find of hoSessionDD EQ Index.1
36881>>>>>            
36881>>>>>        If (Found) Begin
36883>>>>>            //  Calculate timespan between now and last access time
36883>>>>>            Move (CurrentDateTime()) to dtCurrent
36884>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36885>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36886>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36887>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36888>>>>>            
36888>>>>>            //  Check if session didn't time out
36888>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36890>>>>>                Forward Get ValidateSession sSessionKey to bResult
36892>>>>>                   
36892>>>>>                If (bResult) Begin
36894>>>>>                    //  Update session record
36894>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36895>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36896>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36897>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36898>>>>>                    Get Request_Validate of hoSessionDD to iErr
36899>>>>>                    If (iErr) Begin
36901>>>>>                        // this should not happen. If it does its a programming error
36901>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36902>>>>>>
36902>>>>>                        Function_Return False
36903>>>>>                    End
36903>>>>>>
36903>>>>>                    Send Request_Save of hoSessionDD
36904>>>>>                    
36904>>>>>                    //  Update user properties
36904>>>>>                    Send UpdateSessionProperties False
36905>>>>>                End
36905>>>>>>
36905>>>>>            End
36905>>>>>>
36905>>>>>            Else Begin
36906>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36906>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36907>>>>>                
36907>>>>>                If (not(bCreatingNewSession)) Begin
36909>>>>>                    If (not(bLoadWebApp)) Begin
36911>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36912>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36913>>>>>>
36913>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36914>>>>>                    End
36914>>>>>>
36914>>>>>                    Else Begin
36915>>>>>                        Set pbCreatingNewSession to True                    
36916>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36917>>>>>                        Set pbCreatingNewSession to False                        
36918>>>>>                    End
36918>>>>>>
36918>>>>>                End
36918>>>>>>
36918>>>>>            End
36918>>>>>>
36918>>>>>        End
36918>>>>>>
36918>>>>>        Else Begin
36919>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36920>>>>>>
36920>>>>>        End
36920>>>>>>
36920>>>>>        
36920>>>>>        Function_Return bResult
36921>>>>>    End_Function
36922>>>>>    
36922>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36924>>>>>        If (not(pbPasswordHashing(Self))) Begin
36926>>>>>            Move sPassword to sHash
36927>>>>>            Function_Return True
36928>>>>>        End
36928>>>>>>
36928>>>>>        
36928>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
36930>>>>>            Function_Return False
36931>>>>>        End
36931>>>>>>
36931>>>>>        Move ("V1$" + sHash) to sHash
36932>>>>>        Function_Return True
36933>>>>>    End_Function
36934>>>>>    
36934>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
36936>>>>>        If (not(pbPasswordHashing(Self))) Begin
36938>>>>>            Move False to bShouldUpgrade
36939>>>>>            Function_Return (sUserPassword = sEnteredPassword)
36940>>>>>        End
36940>>>>>>
36940>>>>>        
36940>>>>>        String sVersion
36940>>>>>        Move (Left(sUserPassword, 3)) to sVersion
36941>>>>>        If (sVersion = "V1$") Begin
36943>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
36946>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
36947>>>>>        End
36947>>>>>>
36947>>>>>        Else Begin
36948>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
36951>>>>>            Function_Return False
36952>>>>>        End
36952>>>>>>
36952>>>>>    End_Function
36953>>>>>    
36953>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
36955>>>>>        Handle hoUserDD
36955>>>>>        Integer iErr
36955>>>>>        Get phoUserDD to hoUserDD
36956>>>>>        
36956>>>>>        //  Find the user
36956>>>>>        Send Clear of hoUserDD
36957>>>>>        Move sLoginName to WebAppUser.LoginName
36958>>>>>        Send Find of hoUserDD EQ Index.1
36959>>>>>        If (Found) Begin
36961>>>>>            Send Clear of hoUserDD
36962>>>>>            Function_Return False
36963>>>>>        End
36963>>>>>>
36963>>>>>        
36963>>>>>        Send Clear of hoUserDD
36964>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
36965>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
36966>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
36968>>>>>            Send Clear of hoUserDD
36969>>>>>            Function_Return False
36970>>>>>        End
36970>>>>>>
36970>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
36971>>>>>        Get Request_Validate of hoUserDD to iErr
36972>>>>>        If (iErr) Begin
36974>>>>>            Send Clear of hoUserDD
36975>>>>>            Function_Return False
36976>>>>>        End
36976>>>>>>
36976>>>>>        
36976>>>>>        Send Request_Save of hoUserDD
36977>>>>>        Function_Return (not(Err))
36978>>>>>    End_Function
36979>>>>>    
36979>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
36981>>>>>        String sSessionKey sUserPassword
36981>>>>>        Handle hoSessionDD hoUserDD
36981>>>>>        Boolean bMatch bUpgrade
36981>>>>>        
36981>>>>>        Get phoSessionDD to hoSessionDD
36982>>>>>        Get phoUserDD to hoUserDD
36983>>>>>        Integer iErr eLoginMode
36983>>>>>        
36983>>>>>        // Refind session record
36983>>>>>        Get psSessionKey to sSessionKey
36984>>>>>        Send Clear of hoSessionDD
36985>>>>>        Move sSessionKey to WebAppSession.SessionKey
36986>>>>>        Send Find of hoSessionDD EQ Index.1
36987>>>>>        
36987>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
36989>>>>>            Get peLoginMode to eLoginMode
36990>>>>>            
36990>>>>>            //  Find the user
36990>>>>>            Move sLoginName to WebAppUser.LoginName
36991>>>>>            Send Find of hoUserDD EQ Index.1
36992>>>>>            
36992>>>>>            // Check username and password
36992>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
36994>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
36995>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
36996>>>>>                
36996>>>>>                If (bMatch) Begin
36998>>>>>                    // Store the login
36998>>>>>                    If (bUpgrade) Begin
37000>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37001>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37004>>>>>                    End
37004>>>>>>
37004>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37005>>>>>                    Get Request_Validate of hoSessionDD to iErr
37006>>>>>                    If (iErr) Begin
37008>>>>>                        // this should not happen. If it does its a programming error
37008>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37009>>>>>>
37009>>>>>                        Function_Return False
37010>>>>>                    End
37010>>>>>>
37010>>>>>                    
37010>>>>>                    Send Request_Save of hoSessionDD
37011>>>>>                    
37011>>>>>                    // Update session properties
37011>>>>>                    Send UpdateSessionProperties False
37012>>>>>                    Send NotifyChangeRights
37013>>>>>                    Function_Return True
37014>>>>>                End
37014>>>>>>
37014>>>>>                Else Begin
37015>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37015>>>>>                    Send Clear of hoUserDD
37016>>>>>                End
37016>>>>>>
37016>>>>>            End
37016>>>>>>
37016>>>>>            Else Begin
37017>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37017>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37018>>>>>            End
37018>>>>>>
37018>>>>>        End
37018>>>>>>
37018>>>>>        Else Begin
37019>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37019>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37020>>>>>        End
37020>>>>>>
37020>>>>>          
37020>>>>>        Function_Return False
37021>>>>>    End_Function
37022>>>>>    
37022>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37024>>>>>        Handle hoUserDD
37024>>>>>        Integer iErr
37024>>>>>        Get phoUserDD to hoUserDD
37025>>>>>        
37025>>>>>        //  Find the user
37025>>>>>        Send Clear of hoUserDD
