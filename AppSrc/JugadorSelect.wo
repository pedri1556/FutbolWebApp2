Use cWebView.pkg
Use cWebPanel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cjugadorDataDictionary.dd

Open jugador

Object oJugadorSelect is a cWebView
    Set psCaption to "Lista de Jugadores"
    Set peViewType to vtSelect
    Set pbServerOnShow to True 

    { WebProperty=Client }
    Property Boolean pbAllowNoLogin True

    Object ojugador_DD is a cjugadorDataDictionary
    End_Object 

    Set Main_DD to ojugador_DD
    Set Server  to ojugador_DD

    Object oWebMainPanel is a cWebPanel
        Object oJugadorList is a cWebList
            Set pbFillHeight to True
            Set Server to ojugador_DD
            Set piOrdering to 1 

            Object ojugador_Nombre is a cWebColumn
                Entry_Item jugador.Nombre
                Set psCaption to "Nombre del Jugador"
                Set piWidth to 300
            End_Object 
        End_Object
    End_Object 

    Procedure OnShow
        Integer iContador
        Forward Send OnShow
        Move 0 to iContador
        Send Clear of ojugador_DD
        Send Find of ojugador_DD FIRST_RECORD 1
        While (Found)
            Increment iContador
            Send Find of ojugador_DD NEXT_RECORD 1
        Loop
        
        If (iContador = 0) Begin
            Send UserError "No se encuentran Jugadores. Revisa la tabla." "DEBUG"
        End
        Else Begin
            Send ShowInfoBox ("¡Éxito! Encontrados " + String(iContador) + " jugadores.")
        End
        Send GridRefresh of oJugadorList
    End_Procedure
End_Object