// JugadorSelect.wo  Lista de Jugadores (vtSelect)
Use cWebView.pkg
Use cWebPanel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cWebButton.pkg
Use cjugadorDataDictionary.dd
Use cequipoDataDictionary.dd
Use cligaDataDictionary.dd

Object oJugadorSelect is a cWebView
    Set psCaption      to "Jugadores"
    Set peViewType     to vtSelect
    Set pbServerOnShow to True

    { WebProperty=Client }
    Property Boolean pbAllowNoLogin True

    Object oliga_DD is a cligaDataDictionary
    End_Object

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
    End_Object

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server to oequipo_DD
    End_Object

    Set Main_DD to ojugador_DD
    Set Server  to ojugador_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oBarraTop is a cWebGroup
            Set piColumnCount to 12
            Set psCSSClass    to "ButtonBar"

            Object oBtnNuevo is a cWebButton
                Set piColumnSpan    to 2
                Set psCaption       to "+ Nuevo Jugador"
                Set pbServerOnClick to True
                Procedure OnClick
                    Send Clear of ojugador_DD
                    Send NavigatePath of oJugador
                End_Procedure
            End_Object
        End_Object

        Object oJugadorList is a cWebList
            Set piColumnSpan to 12
            Set pbFillHeight to True
            Set Server       to ojugador_DD
            Set piOrdering   to 1

            Procedure OnSelect String sRowId
                Forward Send OnSelect sRowId
                Send NavigatePath of oJugador
            End_Procedure

            Object oColNombre is a cWebColumn
                Entry_Item jugador.Nombre
                Set psCaption to "Nombre"
                Set piWidth   to 160
            End_Object

            Object oColApellido is a cWebColumn
                Entry_Item jugador.Apellido
                Set psCaption to "Apellido"
                Set piWidth   to 160
            End_Object

            Object oColEquipo is a cWebColumn
                Entry_Item equipo.Nombre
                Set psCaption to "Equipo"
                Set piWidth   to 180
            End_Object

            Object oColLiga is a cWebColumn
                Entry_Item liga.Nombre
                Set psCaption to "Liga"
                Set piWidth   to 150
            End_Object
        End_Object

    End_Object

    Procedure OnShow
        Forward Send OnShow
        Send Clear of ojugador_DD
        Send Find of ojugador_DD FIRST_RECORD 1
        Send GridRefresh of oJugadorList
    End_Procedure

End_Object
