Use AllWebAppClasses.pkg
Use cConnection.pkg
Use cWebMenuItem.pkg
Use cWebMenuButton.pkg
Use cWebSessionManager.pkg

Object oApplication is a cApplication
    Object oConnection is a cConnection
        Use LoginEncryption.pkg
    End_Object
End_Object

Object oWebApp is a cWebApp
    Set psTheme          to "Df_Material"
    Set peAlignView      to alignCenter
    Set peApplicationStyle to wvsDesktop
    Set peLoginMode      to lmLoginNone

    Register_Object oDashboard
    Register_Object oLigaSelect
    Register_Object oEquipoSelect
    Register_Object oEntrenadorSelect
    Register_Object oJugadorSelect
    Register_Object oPosicionSelect

    Object oSessionManager is a cWebSessionManager
        Function CheckAccess String sMemberName Returns Boolean
            Function_Return True
        End_Function
    End_Object

    // BARRA DE NAVEGACI├ôN SUPERIOR
    Object oHeaderPanel is a cWebPanel
        Set peRegion to prTop

        Object oNavMenu is a cWebMenuButton
            Set psCaption to "Menu"

            Object oItem_Dashboard is a cWebMenuItem
                Set psCaption to "Inicio"
                Procedure OnClick
                    Send Show of oDashboard
                End_Procedure
            End_Object

            Object oItem_Liga is a cWebMenuItem
                Set psCaption to "Ligas"
                Procedure OnClick
                    Send Show of oLigaSelect
                End_Procedure
            End_Object

            Object oItem_Equipo is a cWebMenuItem
                Set psCaption to "Equipos"
                Procedure OnClick
                    Send Show of oEquipoSelect
                End_Procedure
            End_Object

            Object oItem_Entrenador is a cWebMenuItem
                Set psCaption to "Entrenadores"
                Procedure OnClick
                    Send Show of oEntrenadorSelect
                End_Procedure
            End_Object

            Object oItem_Jugador is a cWebMenuItem
                Set psCaption to "Jugadores"
                Procedure OnClick
                    Send Show of oJugadorSelect
                End_Procedure
            End_Object

            Object oItem_Posicion is a cWebMenuItem
                Set psCaption to "Posiciones"
                Procedure OnClick
                    Send Show of oPosicionSelect
                End_Procedure
            End_Object
        End_Object
    End_Object

    // RECURSOS
    Use WebResourceManager.wo

    //  VISTAS DE DETALLE (ZOOM) 
    Use Liga.wo
    Use Equipo.wo
    Use Entrenador.wo
    Use Jugador.wo
    Use Posicion.wo

    //  VISTAS DE LISTA (SELECT) 
    Use LigaSelect.wo
    Use EquipoSelect.wo
    Use EntrenadorSelect.wo
    Use JugadorSelect.wo
    Use PosicionSelect.wo

    //  DASHBOARD 
    Use Dashboard.wo

    Set phoDefaultView to oDashboard
End_Object

Send StartWebApp of oWebApp