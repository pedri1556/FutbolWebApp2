// PosicionSelect.wo Lista de Posiciones (vtSelect)
Use cWebView.pkg
Use cWebPanel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cWebButton.pkg
Use cposicionDataDictionary.dd

Object oPosicionSelect is a cWebView
    Set psCaption      to "Posiciones"
    Set peViewType     to vtSelect
    Set pbServerOnShow to True

    { WebProperty=Client }
    Property Boolean pbAllowNoLogin True

    Object oposicion_DD is a cposicionDataDictionary
    End_Object

    Set Main_DD to oposicion_DD
    Set Server  to oposicion_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oBarraTop is a cWebGroup
            Set piColumnCount to 12
            Set psCSSClass    to "ButtonBar"

            Object oBtnNueva is a cWebButton
                Set piColumnSpan    to 2
                Set psCaption       to "+ Nueva Posición"
                Set pbServerOnClick to True
                Procedure OnClick
                    Send Clear of oposicion_DD
                    Send Show of oPosicion
                End_Procedure
            End_Object
        End_Object

        Object oPosicionList is a cWebList
            Set piColumnSpan to 12
            Set pbFillHeight to True
            Set Server       to oposicion_DD
            Set piOrdering   to 1

            Procedure OnSelect String sRowId
                Forward Send OnSelect sRowId
                Send Show of oPosicion
            End_Procedure

            Object oColNombre is a cWebColumn
                Entry_Item posicion.Nombre
                Set psCaption to "Posición"
                Set piWidth   to 300
            End_Object
        End_Object

    End_Object

    Procedure OnShow
        Forward Send OnShow
        Send Clear of oposicion_DD
        Send Find of oposicion_DD FIRST_RECORD 1
        Send GridRefresh of oPosicionList
    End_Procedure

End_Object
