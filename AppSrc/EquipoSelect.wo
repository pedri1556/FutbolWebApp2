Use cWebView.pkg
Use cWebPanel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cequipoDataDictionary.dd

Open equipo

Object oEquipoSelect is a cWebView
    Set psCaption to "Lista de Equipos"
    Set peViewType to vtSelect
    Set pbServerOnShow to True 

    { WebProperty=Client }
    Property Boolean pbAllowNoLogin True

    Object oequipo_DD is a cequipoDataDictionary
    End_Object 

    Set Main_DD to oequipo_DD
    Set Server  to oequipo_DD

    Object oWebMainPanel is a cWebPanel
        Object oEquipoList is a cWebList
            Set pbFillHeight to True
            Set Server to oequipo_DD
            Set piOrdering to 1 

            Object oequipo_Nombre is a cWebColumn
                Entry_Item equipo.Nombre
                Set psCaption to "Nombre del Equipo"
                Set piWidth to 300
            End_Object 
        End_Object
    End_Object 

    Procedure OnShow
        Integer iContador
        Forward Send OnShow
        Move 0 to iContador
        Send Clear of oequipo_DD
        Send Find of oequipo_DD FIRST_RECORD 1
        While (Found)
            Increment iContador
            Send Find of oequipo_DD NEXT_RECORD 1
        Loop
        
        If (iContador = 0) Begin
            Send UserError "No se encuentran Equipos." "DEBUG"
        End
        Else Begin
            Send ShowInfoBox ("¡Éxito! Encontrados " + String(iContador) + " equipos.")
        End
        Send GridRefresh of oEquipoList
    End_Procedure
End_Object